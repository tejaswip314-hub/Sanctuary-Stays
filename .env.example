# Google Maps JavaScript API key (client-side key — restrict it by HTTP referrer).
# Required for the interactive map. Create one at https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Google Cloud "Map ID" for vector styling + Advanced Markers.
# Leave blank to fall back to Google's shared DEMO_MAP_ID for local testing.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: server-side key for the Google Air Quality API (current conditions + AQI).
# Enable the "Air Quality API" on the same Google Cloud project and restrict this key
# by API (not by HTTP referrer). When unset, the app falls back to the free
# Open-Meteo Air Quality API so the AQI chip still works out of the box.
GOOGLE_AIR_QUALITY_API_KEY=
